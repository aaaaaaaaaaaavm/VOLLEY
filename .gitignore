# Python
__pycache__/
*.pyc
.venv/
venv/

# LaTeX build intermediates
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.bbl
*.blg
# Transient pdflatex/latexmk/tectonic output. The committed PDF is
# VOLLEY_IEEE_Conference.pdf, refreshed from paper.tex whenever the paper changes.
# NOTE: this comment is on its own line deliberately. It was previously trailing the
# pattern on line 17, and '#' only opens a comment at the START of a line in .gitignore --
# so the pattern was the entire string including the comment text, and matched nothing.
# paper.pdf was therefore never actually ignored.
paper.pdf

# OS
.DS_Store

# GMAT run artifacts (regenerate with validation/gmat/build_scripts.py)
validation/gmat/output/

# CalculiX run artifacts (decks are regenerated by validation/fea/build_deck.py)
validation/fea/*.inp
validation/fea/*.dat
validation/fea/*.frd
validation/fea/*.sta
validation/fea/*.cvg
validation/fea/*.12d
validation/fea/*.log

# CV build intermediates. cv.tex is generated by paper/cv/make_cv.py; cv.pdf is the deliverable
# and IS committed, since a CV that has to be built to be read is useless to a recruiter.
paper/cv/*.aux
paper/cv/*.log
paper/cv/*.out


# A2 band 4 (validation/fem3d): the 3-D mesh and the getdp working files are DERIVED and
# large -- 109 MB and 6.3 MB. build_mesh.py and make_pro.py regenerate them from
# analysis/motor_model.py in one command, so committing them would store an output that is
# already a function of a committed input. The RESULT (b_midgap.txt, band4_result.json) is
# small and is committed.
validation/fem3d/*.msh
validation/fem3d/*.pre
validation/fem3d/*.res
validation/fem3d/*.pos
validation/fem3d/diag_*.txt
validation/fem3d/p[0-9].txt
validation/cfd/field_cache.npz
