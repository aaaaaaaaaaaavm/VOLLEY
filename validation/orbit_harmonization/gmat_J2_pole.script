Create Spacecraft Sat;
GMAT Sat.DateFormat = TAIGregorian;
GMAT Sat.Epoch = '29 Sep 2026 00:00:00.000';
GMAT Sat.CoordinateSystem = EarthMJ2000Eq;
GMAT Sat.DisplayStateType = Cartesian;
GMAT Sat.X = 6828.137;
GMAT Sat.Y = 0;
GMAT Sat.Z = 0;
GMAT Sat.VX = 0;
GMAT Sat.VY = 4.755661219009803;
GMAT Sat.VZ = 6.000151173246255;
Create Spacecraft Pole;
GMAT Pole.DateFormat = TAIGregorian;
GMAT Pole.Epoch = '29 Sep 2026 00:00:00.000';
GMAT Pole.CoordinateSystem = EarthFixed;
GMAT Pole.DisplayStateType = Cartesian;
GMAT Pole.X = 0;
GMAT Pole.Y = 0;
GMAT Pole.Z = 7000;
GMAT Pole.VX = 0;
GMAT Pole.VY = 0;
GMAT Pole.VZ = 0;
Create ForceModel FM;
GMAT FM.CentralBody = Earth;
GMAT FM.PrimaryBodies = {Earth};
GMAT FM.GravityField.Earth.Degree = 2;
GMAT FM.GravityField.Earth.Order = 0;
GMAT FM.GravityField.Earth.PotentialFile = JGM2.cof;
GMAT FM.GravityField.Earth.TideModel = None;
GMAT FM.Drag = None;
GMAT FM.SRP = Off;
Create Propagator Prop;
GMAT Prop.FM = FM;
GMAT Prop.Type = RungeKutta89;
GMAT Prop.Accuracy = 1e-12;
GMAT Prop.MinStep = 0.001;
GMAT Prop.MaxStep = 30;
Create ReportFile OrbitReport;
GMAT OrbitReport.Filename = 'gmat_J2_pole.txt';
GMAT OrbitReport.Precision = 16;
GMAT OrbitReport.ColumnWidth = 26;
GMAT OrbitReport.WriteHeaders = true;
Create Variable k initialEpoch targetEpoch;
BeginMissionSequence;
GMAT initialEpoch = Sat.A1ModJulian;
Report OrbitReport Sat.ElapsedSecs Sat.EarthMJ2000Eq.X Sat.EarthMJ2000Eq.Y Sat.EarthMJ2000Eq.Z Sat.EarthMJ2000Eq.VX Sat.EarthMJ2000Eq.VY Sat.EarthMJ2000Eq.VZ Sat.Earth.SMA Sat.Earth.ECC Pole.EarthMJ2000Eq.X Pole.EarthMJ2000Eq.Y Pole.EarthMJ2000Eq.Z;
For k = 1:1440;
 GMAT targetEpoch = initialEpoch + k / 1440;
 Propagate Prop(Sat) {Sat.A1ModJulian = targetEpoch};
 GMAT Pole.A1ModJulian = Sat.A1ModJulian;
 GMAT Pole.EarthFixed.X = 0;
 GMAT Pole.EarthFixed.Y = 0;
 GMAT Pole.EarthFixed.Z = 7000;
 Report OrbitReport Sat.ElapsedSecs Sat.EarthMJ2000Eq.X Sat.EarthMJ2000Eq.Y Sat.EarthMJ2000Eq.Z Sat.EarthMJ2000Eq.VX Sat.EarthMJ2000Eq.VY Sat.EarthMJ2000Eq.VZ Sat.Earth.SMA Sat.Earth.ECC Pole.EarthMJ2000Eq.X Pole.EarthMJ2000Eq.Y Pole.EarthMJ2000Eq.Z;
EndFor;
