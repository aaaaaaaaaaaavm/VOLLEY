% PCS-ACR1-01: independent lunar surrogate, not the LEO ACR1 mission.
SolarSystem.EphemerisSource = 'DE421';
SolarSystem.DEFilename = '/workspace/volley-work/runtime-gmat/GMAT/R2026a/data/planetary_ephem/de/leDE1900.421';
SolarSystem.EphemerisUpdateInterval = 0;
Luna.EquatorialRadius = 1737.4;
Luna.Flattening = 0;
Luna.PlanetarySpiceKernelName = {'/workspace/volley-work/runtime-gmat/GMAT/R2026a/data/planetary_coeff/SPICELunaCurrentKernel.bpc'};
Luna.FrameSpiceKernelName = {'/workspace/volley-work/runtime-gmat/GMAT/R2026a/data/planetary_coeff/SPICELunaFrameKernel.tf'};
Luna.RotationDataSource = 'SPICE';
Luna.SpiceFrameId = 'MOON_PA';
Create CoordinateSystem MoonFrame;
MoonFrame.Origin = Luna;
MoonFrame.Axes = MJ2000Eq;
Create Spacecraft Payload;
Payload.DateFormat = UTCGregorian;
Payload.Epoch = '25 Oct 2026 12:00:00.000';
Payload.CoordinateSystem = MoonFrame;
Payload.DisplayStateType = Cartesian;
Payload.X = -1837.4;
Payload.Y = 0;
Payload.Z = 0;
Payload.VX = 0;
Payload.VY = 0;
Payload.VZ = -1.63054360773454;
Payload.DryMass = 4;
Create ForceModel MoonForces;
MoonForces.CentralBody = Luna;
MoonForces.PrimaryBodies = {Luna};
MoonForces.PointMasses = {Earth, Sun};
MoonForces.Drag = None;
MoonForces.SRP = Off;
MoonForces.GravityField.Luna.Degree = 40;
MoonForces.GravityField.Luna.Order = 40;
MoonForces.GravityField.Luna.PotentialFile = '/workspace/volley-work/runtime-gmat/GMAT/R2026a/data/gravity/luna/grgm900c.cof';
MoonForces.RelativisticCorrection = Off;
Create Propagator MoonProp;
MoonProp.FM = MoonForces;
MoonProp.Type = PrinceDormand78;
MoonProp.InitialStepSize = 30;
MoonProp.Accuracy = 1e-12;
MoonProp.MinStep = 0.001;
MoonProp.MaxStep = 120;
MoonProp.MaxStepAttempts = 50;
MoonProp.StopIfAccuracyIsViolated = true;
Create ReportFile History;
History.Filename = '/workspace/VOLLEY/validation/programme_closure_acr1/native/apo100_u-3_d40.txt';
History.WriteHeaders = true;
History.Precision = 16;
History.Add = {Payload.ElapsedDays, Payload.Luna.RMAG, Payload.Luna.SMA, Payload.Luna.ECC};
BeginMissionSequence;
Propagate MoonProp(Payload) {Payload.Luna.RMAG = 1737.4, Payload.ElapsedDays = 30};
