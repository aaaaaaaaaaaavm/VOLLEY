% Provisional native lunar coast. Units: km, km/s, seconds, degrees.
% Initial plane is specified relative to MJ2000Eq, not asserted to be lunar-polar.
SolarSystem.EphemerisSource = 'DE421';
SolarSystem.DEFilename = '/workspace/volley-work/runtime-gmat/GMAT/R2026a/data/planetary_ephem/de/leDE1900.421';
SolarSystem.EphemerisUpdateInterval = 0;
Earth.NutationUpdateInterval = 0;
Earth.EopFileName = '/workspace/volley-work/runtime-gmat/GMAT/R2026a/data/planetary_coeff/eopc04_08.62-now';
Earth.Mu = 398600.435507;
Sun.Mu = 132712440017.99;
Luna.Mu = 4902.79996708864;
Luna.EquatorialRadius = 1737.4;
Luna.Flattening = 0;
Luna.PlanetarySpiceKernelName = {'/workspace/volley-work/runtime-gmat/GMAT/R2026a/data/planetary_coeff/SPICELunaCurrentKernel.bpc'};
Luna.FrameSpiceKernelName = {'/workspace/volley-work/runtime-gmat/GMAT/R2026a/data/planetary_coeff/SPICELunaFrameKernel.tf'};
Luna.RotationDataSource = 'SPICE';
Luna.SpiceFrameId = 'MOON_PA';
Create CoordinateSystem LunaMJ2000Eq;
LunaMJ2000Eq.Origin = Luna;
LunaMJ2000Eq.Axes = MJ2000Eq;
Create Spacecraft Sat;
Sat.DateFormat = TAIGregorian;
Sat.Epoch = '23 Oct 2026 00:00:00.000';
Sat.CoordinateSystem = LunaMJ2000Eq;
Sat.DisplayStateType = Cartesian;
Sat.X = 1837.4;
Sat.Y = 0;
Sat.Z = 0;
Sat.VX = 0;
Sat.VY = 1.7869742906091;
Sat.VZ = 0;
Sat.DryMass = 300;
Sat.SRPArea = 0;
Sat.DragArea = 0;
Create ForceModel MoonForces;
MoonForces.CentralBody = Luna;
MoonForces.PrimaryBodies = {Luna};
MoonForces.PointMasses = {Earth, Sun};
MoonForces.Drag = None;
MoonForces.SRP = Off;
MoonForces.RelativisticCorrection = Off;
MoonForces.ErrorControl = RSSStep;
MoonForces.GravityField.Luna.Degree = 20;
MoonForces.GravityField.Luna.Order = 20;
MoonForces.GravityField.Luna.PotentialFile = '/workspace/volley-work/runtime-gmat/GMAT/R2026a/data/gravity/luna/grgm900c.cof';
MoonForces.GravityField.Luna.TideModel = None;
Create Propagator Coast;
Coast.FM = MoonForces;
Coast.Type = PrinceDormand78;
Coast.InitialStepSize = 60;
Coast.Accuracy = 1e-11;
Coast.MinStep = 0.001;
Coast.MaxStep = 120;
Coast.MaxStepAttempts = 50;
Coast.StopIfAccuracyIsViolated = true;
Create ReportFile History Checkpoints Configuration;
History.Filename = '/workspace/volley-work/2026-10-23-lunar-native/runs/p100_a1000_i0_d20_s120.csv';
History.Precision = 16;
History.FixedWidth = false;
History.Delimiter = ',';
History.WriteHeaders = true;
History.Add = {Sat.ElapsedSecs, Sat.LunaMJ2000Eq.X, Sat.LunaMJ2000Eq.Y, Sat.LunaMJ2000Eq.Z, Sat.LunaMJ2000Eq.VX, Sat.LunaMJ2000Eq.VY, Sat.LunaMJ2000Eq.VZ, Sat.Luna.RMAG, Sat.Luna.SMA, Sat.Luna.ECC, Sat.Luna.RadPer, Sat.Luna.RadApo};
Checkpoints.Filename = '/workspace/volley-work/2026-10-23-lunar-native/runs/p100_a1000_i0_d20_s120_checkpoints.csv';
Checkpoints.Precision = 16;
Checkpoints.FixedWidth = false;
Checkpoints.Delimiter = ',';
Checkpoints.WriteHeaders = true;
Configuration.Filename = '/workspace/volley-work/2026-10-23-lunar-native/runs/p100_a1000_i0_d20_s120_configuration.script';
BeginMissionSequence;
Write SolarSystem Luna Earth Sun LunaMJ2000Eq MoonForces Coast Sat {Style = Script, MessageWindow = false, ReportFile = Configuration};
Write Luna.Mu Luna.EquatorialRadius Earth.Mu Earth.EquatorialRadius Earth.Flattening Earth.NutationUpdateInterval Sun.Mu {Style = Verbose, MessageWindow = false, ReportFile = Configuration};
Propagate Coast(Sat) {Sat.ElapsedSecs = 604800, Sat.Luna.RMAG = 1737.4, StopTolerance = 1e-6};
Report Checkpoints Sat.ElapsedSecs Sat.LunaMJ2000Eq.X Sat.LunaMJ2000Eq.Y Sat.LunaMJ2000Eq.Z Sat.LunaMJ2000Eq.VX Sat.LunaMJ2000Eq.VY Sat.LunaMJ2000Eq.VZ Sat.Luna.RMAG Sat.Luna.SMA Sat.Luna.ECC Sat.Luna.RadPer Sat.Luna.RadApo;
If Sat.ElapsedSecs >= 604799.99;
