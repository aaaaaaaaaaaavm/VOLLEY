Report Checkpoints Sat.ElapsedSecs Sat.LunaMJ2000Eq.X Sat.LunaMJ2000Eq.Y Sat.LunaMJ2000Eq.Z Sat.LunaMJ2000Eq.VX Sat.LunaMJ2000Eq.VY Sat.LunaMJ2000Eq.VZ Sat.Luna.RMAG Sat.Luna.SMA Sat.Luna.ECC Sat.Luna.RadPer Sat.Luna.RadApo;
If Sat.ElapsedSecs >= 2591999.99;
Propagate Coast(Sat) {Sat.ElapsedSecs = 7776000, Sat.Luna.RMAG = 1737.4, StopTolerance = 1e-6};
Report Checkpoints Sat.ElapsedSecs Sat.LunaMJ2000Eq.X Sat.LunaMJ2000Eq.Y Sat.LunaMJ2000Eq.Z Sat.LunaMJ2000Eq.VX Sat.LunaMJ2000Eq.VY Sat.LunaMJ2000Eq.VZ Sat.Luna.RMAG Sat.Luna.SMA Sat.Luna.ECC Sat.Luna.RadPer Sat.Luna.RadApo;
If Sat.ElapsedSecs >= 7775999.99;
